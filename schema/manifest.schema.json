{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Colab Studio Batch Manifest",
  "type": "object",
  "required": ["jobs"],
  "properties": {
    "model": {
      "type": "string",
      "default": "qwen-image-2.1-turbo",
      "enum": ["qwen-image-2.1-turbo", "qwen-image-2.1-turbo-gguf", "qwen21"]
    },
    "quant": {
      "type": "string",
      "default": "INT8",
      "enum": ["INT8", "BF16", "Q2_K", "Q3_K_S", "Q3_K_M", "Q3_K_XL", "Q4_K_S", "Q4_K_M", "Q5_K_S", "Q5_K_M", "Q6_K", "Q6_K_XL", "Q8_0", "F16"]
    },
    "refine_prompt": {
      "type": "boolean",
      "default": false,
      "description": "Enable official Qwen 3.5 9B Prompt Enhancer for all jobs unless overridden per job."
    },
    "pe_variant": {
      "type": "string",
      "default": "int8",
      "enum": ["int8", "w4a8"]
    },
    "text_encoder_variant": {
      "type": "string",
      "default": "int8",
      "enum": ["int8", "w4a8"]
    },
    "aspect_ratio": {
      "type": "string",
      "default": "1:1",
      "enum": ["1:1", "4:3", "3:4", "3:2", "2:3", "16:9", "9:16"]
    },
    "resolution": {
      "type": "string",
      "default": "1K",
      "enum": ["1K", "2K"]
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,60}$"
          },
          "mode": {
            "type": "string",
            "default": "t2i",
            "enum": ["t2i", "edit"]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_prompt": {
            "type": "string",
            "default": ""
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 10
          },
          "quant": {
            "type": "string",
            "enum": ["INT8", "BF16", "Q2_K", "Q3_K_S", "Q3_K_M", "Q3_K_XL", "Q4_K_S", "Q4_K_M", "Q5_K_S", "Q5_K_M", "Q6_K", "Q6_K_XL", "Q8_0", "F16"]
          },
          "refine_prompt": {
            "type": "boolean"
          },
          "thinking": {
            "type": "boolean",
            "default": true
          },
          "pe_max_length": {
            "type": "integer",
            "default": 4096
          },
          "pe_variant": {
            "type": "string",
            "enum": ["int8", "w4a8"]
          },
          "transparent": {
            "type": "boolean",
            "default": false
          },
          "aspect_ratio": {
            "type": "string",
            "enum": ["1:1", "4:3", "3:4", "3:2", "2:3", "16:9", "9:16"]
          },
          "resolution": {
            "type": "string",
            "enum": ["1K", "2K"]
          },
          "width": {
            "type": "integer",
            "minimum": 32,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 32,
            "maximum": 4096
          },
          "custom_size": {
            "type": "boolean"
          },
          "edit_resolution": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "seed": {
            "type": "integer",
            "default": 42
          }
        }
      }
    }
  }
}
